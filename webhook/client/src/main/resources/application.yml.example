server:
  port: 8081
  servlet:
    context-path: /client-api

spring:
  datasource:
    username: root
    url: jdbc:mysql://localhost:3306/db_test
    password: 123456
    driverClassName: com.mysql.cj.jdbc.Driver
  jpa:
    properties:
      hibernate:
        globally_quoted_identifiers: true
        format_sql: true
    show-sql: false
    hibernate:
      ddl-auto: update

order:
  webhook:
    secret-key: your_secret_key_here